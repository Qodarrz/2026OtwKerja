// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Role {
  USER
  ADMIN
  DOCUMENT_VALIDATOR
  FIELD_INSPECTOR
  LEGALIZER
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String?
  name            String?
  provider        AuthProvider     @default(LOCAL)
  providerId      String?
  roles           Role[]           // Changed to array for multiple roles
  verify_gmail    Boolean          @default(false)
  isKtpVerified   Boolean          @default(false)
  
  userDetail      UserDetail?
  otpVerification OtpVerification?
  sessions        Session[]
  
  // Permit relationships
  applications    PermitApplication[]
  validationActions ValidationAction[]
  notifications   Notification[]
  feedbacks       Feedback[]
  notificationSettings NotificationSetting?
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model NotificationSetting {
  id                String   @id @default(uuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String   @unique
  
  // Channels
  emailSlaWarning   Boolean  @default(true)
  pushSlaOverdue    Boolean  @default(true)
  emailStatusUpdate Boolean  @default(true)
  appStatusUpdate   Boolean  @default(true)
  systemAlerts      Boolean  @default(true)
  browserNotifications Boolean @default(true)
  
  // Focus Mode
  focusModeActive   Boolean  @default(false)
  focusModeStart    String   @default("08:00")
  focusModeEnd      String   @default("17:00")
  
  updatedAt         DateTime @updatedAt
}

model UserDetail {
  id        String   @id @default(uuid())
  phone     String?
  address   String?
  avatar    String?
  
  // KTP Data
  nik           String?
  ktpFullName   String?
  ktpBirthDate  DateTime?
  ktpBirthPlace String?
  ktpGender     String?
  ktpAddress    String?
  ktpImageUrl   String?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpVerification {
  id                    String   @id @default(uuid())
  otp_code              String
  otp_expires_at        DateTime
  otp_attempts          Int      @default(0)
  last_otp_requested_at DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String   @unique
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
}

// Permit Management Enums
enum PermitType {
  BUILDING_PERMIT
  BUSINESS_LICENSE
}

enum LandType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  AGRICULTURAL
}

enum WorkflowStage {
  DRAFT
  DOCUMENT_CHECK
  FIELD_INSPECTION
  LEGALIZATION
  APPROVED
  REJECTED
}

enum ActionType {
  SUBMIT
  APPROVE
  REJECT
  RESUBMIT
}

enum NotificationType {
  APPLICATION_SUBMITTED
  STAGE_ADVANCED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  SLA_WARNING
  SLA_OVERDUE
  SLA_ESCALATION
}

enum SLAStatus {
  ON_TIME
  WARNING
  OVERDUE
}

// Permit Application Model
model PermitApplication {
  id                String           @id @default(uuid())
  referenceNumber   String           @unique
  permitType        PermitType
  status            WorkflowStage    @default(DRAFT)
  
  // Applicant
  applicant         User             @relation(fields: [applicantId], references: [id])
  applicantId       String
  
  // Property Information (Building Permit)
  locationAddress   String?
  landSize          Float?           // square meters
  landType          LandType?
  buildingHeight    Float?           // meters
  njopValue         Float?           // Indonesian Rupiah
  isStrategicLocation Boolean?       @default(false)
  
  // Business Information (Business License)
  businessName      String?
  businessType      String?
  businessLocation  String?
  estimatedEmployees Int?
  
  // Tax Calculation
  baseTax           Float?
  strategicSurcharge Float?
  landTypeSurcharge Float?
  highRiseSurcharge Float?
  administrativeFee Float?
  totalCost         Float?
  
  // Workflow
  currentStage      WorkflowStage    @default(DRAFT)
  submittedAt       DateTime?
  lastUpdatedAt     DateTime         @updatedAt
  
  // Rejection
  rejectionReason   String?
  rejectedBy        String?
  rejectedAt        DateTime?
  
  // Field Inspection
  inspectionNotes   String?
  
  // Relationships
  documents         Document[]
  validationActions ValidationAction[]
  stageHistory      StageHistory[]
  notifications     Notification[]
  feedbacks         Feedback[]
  
  // Resubmission tracking
  originalApplicationId String?
  originalApplication   PermitApplication? @relation("Resubmissions", fields: [originalApplicationId], references: [id])
  resubmissions         PermitApplication[] @relation("Resubmissions")
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  @@index([applicantId])
  @@index([status])
  @@index([permitType])
  @@index([referenceNumber])
}

// Document Model
model Document {
  id                String           @id @default(uuid())
  filename          String
  originalFilename  String
  mimeType          String
  fileSize          Int              // bytes
  storagePath       String
  
  application       PermitApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId     String
  
  uploadedAt        DateTime         @default(now())
  
  @@index([applicationId])
}

// Validation Action Model
model ValidationAction {
  id                String           @id @default(uuid())
  actionType        ActionType
  stage             WorkflowStage
  notes             String?
  
  application       PermitApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId     String
  
  performedBy       User             @relation(fields: [performedById], references: [id])
  performedById     String
  
  performedAt       DateTime         @default(now())
  
  @@index([applicationId])
  @@index([performedById])
}

// Stage History Model
model StageHistory {
  id                String           @id @default(uuid())
  fromStage         WorkflowStage?
  toStage           WorkflowStage
  
  application       PermitApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId     String
  
  transitionedBy    String?          // User ID
  transitionedAt    DateTime         @default(now())
  
  // SLA tracking
  completedAt       DateTime?        // When stage was completed
  durationHours     Int?             // Duration in hours
  slaStatus         SLAStatus?       // ON_TIME, WARNING, OVERDUE
  
  @@index([applicationId])
  @@index([slaStatus])
}

// Notification Model
model Notification {
  id                String           @id @default(uuid())
  type              NotificationType
  title             String
  message           String
  isRead            Boolean          @default(false)
  
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  
  application       PermitApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId     String?
  
  createdAt         DateTime         @default(now())
  
  @@index([userId, isRead])
  @@index([applicationId])
}

// Audit Log Model
model AuditLog {
  id                String           @id @default(uuid())
  entityType        String           // "PermitApplication", "User", etc.
  entityId          String
  action            String           // "CREATE", "UPDATE", "DELETE", "APPROVE", "REJECT"
  changes           Json?            // Store before/after state
  performedBy       String?          // User ID
  ipAddress         String?
  userAgent         String?
  
  // Immutability fields
  hash              String?          // SHA-256 hash of this record + previousHash
  previousHash      String?          // Hash of the previous record
  
  createdAt         DateTime         @default(now())
  
  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([createdAt])
  @@index([entityType, action, createdAt])
  @@index([performedBy, createdAt])
}

// Audit Log Archive Model (for logs older than 90 days)
model AuditLogArchive {
  id                String           @id @default(uuid())
  entityType        String
  entityId          String
  action            String
  changes           Json?
  performedBy       String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime
  archivedAt        DateTime         @default(now())
  
  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([entityType, action, createdAt])
  @@index([performedBy, createdAt])
}

// SLA Rules Model
model SLARule {
  id                String           @id @default(uuid())
  stage             WorkflowStage    @unique
  maxDurationHours  Int              // Maximum duration in hours
  warningThreshold  Float            @default(0.8) // Warning at 80% of max duration
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  @@index([stage])
}

model WorkflowTemplate {
  id          String                  @id @default(uuid())
  name        String
  description String?
  permitType  PermitType              @unique
  isActive    Boolean                 @default(true)
  stages      WorkflowTemplateStage[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([permitType])
  @@index([isActive])
}

model WorkflowTemplateStage {
  id                String           @id @default(uuid())
  templateId        String
  template          WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stage             WorkflowStage
  order             Int
  requiredRoles     Role[]
  slaDurationHours  Int              @default(24)
  slaWarningPercent Float            @default(0.8)
  isRequired        Boolean          @default(true)

  @@unique([templateId, stage])
  @@index([templateId])
}

// Bottleneck Detection Engine Enums
enum BottleneckSeverity {
  LOW      // score < 60
  MEDIUM   // score 60-79
  HIGH     // score >= 80
}

enum BottleneckStatus {
  ACTIVE
  RESOLVED
  ARCHIVED
}

enum RecommendationType {
  ADD_STAFF
  REASSIGN_STAFF
  ADJUST_SLA
  OPTIMIZE_PROCESS
  REDISTRIBUTE_WORKLOAD
  OTHER
}

enum RecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

enum ResolutionActionType {
  STAFF_ADDED
  STAFF_REASSIGNED
  SLA_ADJUSTED
  PROCESS_OPTIMIZED
  OTHER
}

// Bottleneck Event Model
model BottleneckEvent {
  id                String   @id @default(uuid())
  stage             WorkflowStage
  score             Int      // 0-100
  severity          BottleneckSeverity
  
  // Contributing metrics
  queueLength       Int
  queueWeight       Float    // 0-100
  avgProcessingTime Float    // hours
  processingWeight  Float    // 0-100
  slaViolationRate  Float    // percentage
  slaWeight         Float    // 0-100
  staffWorkload     Float    // applications per staff
  workloadWeight    Float    // 0-100
  
  // Status tracking
  status            BottleneckStatus @default(ACTIVE)
  detectedAt        DateTime @default(now())
  resolvedAt        DateTime?
  resolutionDuration Int?    // minutes
  
  // Relationships
  recommendations   BottleneckRecommendation[]
  resolutionActions BottleneckResolution[]
  
  @@index([stage, detectedAt])
  @@index([status, detectedAt])
  @@index([score])
}

// Bottleneck Recommendation Model
model BottleneckRecommendation {
  id              String   @id @default(uuid())
  bottleneckId    String
  bottleneck      BottleneckEvent @relation(fields: [bottleneckId], references: [id], onDelete: Cascade)
  
  type            RecommendationType
  priority        RecommendationPriority
  description     String
  specificMetrics Json     // e.g., {"staffToAdd": 2, "targetStage": "DOCUMENT_CHECK"}
  estimatedImpact String   // HIGH, MEDIUM, LOW
  
  createdAt       DateTime @default(now())
  
  @@index([bottleneckId])
}

// Bottleneck Resolution Model
model BottleneckResolution {
  id              String   @id @default(uuid())
  bottleneckId    String
  bottleneck      BottleneckEvent @relation(fields: [bottleneckId], references: [id], onDelete: Cascade)
  
  actionType      ResolutionActionType
  performedBy     String
  performedAt     DateTime @default(now())
  notes           String?
  
  // Effectiveness tracking
  wasEffective    Boolean? // null until evaluated
  evaluatedAt     DateTime?
  
  @@index([bottleneckId])
  @@index([performedBy])
}

// Bottleneck Threshold Model
model BottleneckThreshold {
  id                      String   @id @default(uuid())
  stage                   WorkflowStage? // null = global default
  
  // Threshold values
  queueLengthThreshold    Int      @default(10)
  processingTimeMultiplier Float   @default(1.5)
  slaViolationPercentage  Float    @default(20.0)
  workloadPerStaff        Float    @default(5.0)
  
  // Score threshold
  bottleneckScoreThreshold Int     @default(60)
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  createdBy               String
  
  @@unique([stage])
  @@index([stage])
}

// Bottleneck Event Archive Model
model BottleneckEventArchive {
  id                String   @id
  stage             WorkflowStage
  score             Int
  severity          BottleneckSeverity
  
  queueLength       Int
  queueWeight       Float
  avgProcessingTime Float
  processingWeight  Float
  slaViolationRate  Float
  slaWeight         Float
  staffWorkload     Float
  workloadWeight    Float
  
  status            BottleneckStatus
  detectedAt        DateTime
  resolvedAt        DateTime?
  resolutionDuration Int?
  
  archivedAt        DateTime @default(now())
  
  @@index([stage, detectedAt])
  @@index([archivedAt])
}

// API Key Model (Integration API Layer)
model ApiKey {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([key])
  @@index([isActive])
}

// Feedback Model
enum FeedbackType {
  COMPLAINT
  SUGGESTION
  APPRECIATION
  OTHER
}

model Feedback {
  id              String           @id @default(uuid())
  rating          Int
  comment         String?
  type            FeedbackType     @default(OTHER)
  
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  
  application     PermitApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   String
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  @@index([userId])
  @@index([applicationId])
}
